{
  "name": "routewise",
  "version": "0.1.0",
  "description": "Sistema de Gestao de Frota com Alertas de Velocidade em Tempo Real",
  "private": true,
  "scripts": {
    "test": "jest --coverage --coverageReporters=json-summary --coverageReporters=text",
    "test:ci": "jest --coverage --coverageReporters=json-summary --coverageReporters=lcov",
    "lint": "eslint src/"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "json-summary",
      "text"
    ]
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "danger": "^11.3.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
